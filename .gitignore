# Raw PX4 logs: ~180 MB and GitHub rejects single files over 100 MB
# (log_3_2026-7-24-17-11-46.ulg alone is 120 MB). Keep them on the SD card /
# local disk; the derived tables and plots in out/ are what get committed.
*.ulg

# Generated by the pipeline -- reproducible from raw/ at any time.
# runs/ holds byte-exact copies of raw data plus merged output; committing it
# would double the repo for no benefit.
runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
